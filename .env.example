# PyraClaw Sovereign AI Runtime — Environment Configuration
# DD7 International GmbH | MINTED_GREEN | SURGICAL
# Copy to .env and fill in your keys

# ── NVIDIA ────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── LLM Providers ────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
XAI_API_KEY=your_xai_key
GROQ_API_KEY=your_groq_key

# ── Google Cloud / iAiA Project ──────────────────────────
GOOGLE_CLOUD_PROJECT=iaia-457300
GOOGLE_PROJECT_NUMBER=725993730956
GOOGLE_AI_API_KEY=your_google_ai_key
GOOGLE_CLOUD_REGION=europe-west2

# ── RSFS Parameters ──────────────────────────────────────
RSFS_PHI_TARGET=0.77
RSFS_KAPPA=0.618
RSFS_C_CRIT=52.79
RSFS_C_OPT=78.42
RSFS_FREQ_ICODE=432
RSFS_FREQ_ACODE=528
RSFS_FREQ_CCODE=639
RSFS_FREQ_BRIDGE=963

# ── QDP Constants ────────────────────────────────────────
QDP_VERSION=1.0.0
QDP_SUPER_HASH=9146ce69652472be6ab914e84d2ff76fa64b6ae71c19a0365858c73ee68cda88

# ── Evidence & Identity ──────────────────────────────────
ZENODO_COMMUNITY=pyraclaw
ZENODO_ACCESS_TOKEN=your_zenodo_token
ORCID_BYRON=0009-0001-9561-5483
ORCID_PYRACLAW=0009-0003-9584-1741
ORCID=0009-0003-9584-1741
PATENT_PCT=PCT/EP2025/080977
PATENT_US=US_19/541,276

# ── EU AI Act Compliance ─────────────────────────────────
EU_AI_ACT_COMPLIANT=true
AUDIT_TRAIL_ENABLED=true
HUMAN_OVERSIGHT_REQUIRED=true

# ── Infrastructure ───────────────────────────────────────
POSTGRES_PASSWORD=your_db_password
REDIS_URL=redis://redis:6379
DB_URL=postgresql://pyraclaw:${POSTGRES_PASSWORD}@postgres:5432/pyraclaw

# ── NVIDIA Nemotron GPU (8K Visual) ─────────────────────
NVIDIA_NEMOTRON_API_KEY=your_nvidia_key
NVIDIA_NEMOTRON_DEFAULT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_NEMOTRON_VISION_MODEL=nvidia/llama-3.2-nv-vision-90b
NVIDIA_NEMOTRON_GPU_ACCEL=true
NVIDIA_NEMOTRON_MAX_RESOLUTION=8192

# ── iAiA 2 Cyber Specialist ────────────────────────────
IAIA_HAT_MODE=white
IAIA_AUTH_TOKEN=your_sovereign_auth_token
IAIA_PHASE=1

# ── GLM-4 (iAiA Premium White-Label) ───────────────────
GLM4_API_KEY=your_glm4_key
GLM4_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM4_DEFAULT_MODEL=glm-4-plus
IAIA_PREMIUM_GLM4=true

# ── Mistral + Cohere ────────────────────────────────────
MISTRAL_API_KEY=your_mistral_key
COHERE_API_KEY=your_cohere_key

# ── Blockchain Attestation (Solidity/Rust/Web3) ────────
BLOCKCHAIN_NETWORK=ethereum-mainnet
BLOCKCHAIN_ATTESTATION_CONTRACT=your_contract_address
BLOCKCHAIN_MERKLE_DEPTH=32
WEB3_PROVIDER_URL=your_web3_rpc

# ── Neuromorphic Substrate ──────────────────────────────
NEURO_SUBSTRATE=INTEL-HALA-POINT
NEURO_NEURONS=1150000000
NEURO_SYNAPSES=128000000000

# ── Node Architecture ───────────────────────────────────
IHQIL_NODE_ID=iHQiL
IHQIL_REGION=europe-west2
LIAIA_HAMBURG_NODE_ID=liAiA-Hamburg
LIAIA_HAMBURG_REGION=europe-west3
CALLAGHAN_BRIDGE_VERSION=3.0

# ── OpenVINO (Intel NPU) ───────────────────────────────
OPENVINO_ENABLED=true
OPENVINO_DEVICE=NPU
OPENVINO_MODEL_DIR=/models/openvino

# ── Port Security (5-DIP SHA) ──────────────────────────
PORT_GUARD_SECRET=your_port_guard_secret
PORT_7777_NAME=portboss
PORT_8888_NAME=port8

# ── Runtime ──────────────────────────────────────────────
DEBUG_MODE=false
LOG_LEVEL=INFO
ENABLE_QUANTUM_SIMULATION=true
SANDBOX_MODE=false
PYRACLAW_PROJECT=pyraclaw-sovereign-v1
